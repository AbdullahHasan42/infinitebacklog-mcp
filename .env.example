# Optional - required only for the autonomous agent tool
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BROWSER_USE_API_KEY=

# Optional - JSON array of cookies for logged-in sessions
IB_COOKIES=

# Optional overrides
# IB_HEADLESS=true
# IB_VIEWPORT_WIDTH=1280
# IB_VIEWPORT_HEIGHT=800

# Debug only. Allows the evaluate_js tool to run page JavaScript.
# IB_ALLOW_EVAL_JS=false

# Containers only. Do not enable on a desktop session.
# IB_CHROMIUM_NO_SANDBOX=false
